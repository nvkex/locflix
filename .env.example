LOCFLIX_MOVIES_DIR=D:\TV\Movies
LOCFLIX_SERIES_DIR=D:\TV\Series
# Bind all interfaces so LAN leechers can reach this seeder
LOCFLIX_HOST=0.0.0.0
LOCFLIX_PORT=8787
LOCFLIX_DATA_DIR=./data
LOCFLIX_SCAN_ON_START=true
# Use * so browsers on other LAN devices can call the API
LOCFLIX_CORS_ORIGINS=*
LOCFLIX_LAN_DISCOVERY_PORT=8788
# Free API key: https://www.themoviedb.org/settings/api
LOCFLIX_TMDB_API_KEY=
LOCFLIX_FETCH_POSTERS_ON_SCAN=true
# Free consumer key: https://www.opensubtitles.com/en/consumers
LOCFLIX_OPENSUBTITLES_API_KEY=
